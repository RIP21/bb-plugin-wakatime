{
  "name": "bb-plugin-wakatime",
  "version": "0.2.0",
  "description": "Report bb agent and human coding activity to WakaTime.",
  "keywords": [
    "bb",
    "bb-plugin",
    "wakatime",
    "time-tracking",
    "productivity",
    "ai-coding"
  ],
  "homepage": "https://github.com/RIP21/bb-plugin-wakatime#readme",
  "bugs": {
    "url": "https://github.com/RIP21/bb-plugin-wakatime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIP21/bb-plugin-wakatime.git"
  },
  "license": "MIT",
  "author": "Andrii Los (https://github.com/RIP21)",
  "type": "module",
  "private": false,
  "engines": {
    "bb": ">=0.39",
    "bbPluginSdk": ">=0.4.8"
  },
  "bb": {
    "name": "WakaTime",
    "description": "Tracks time spent in bb threads and reports it to WakaTime through wakatime-cli.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "node scripts/check-fragile-classes.mjs && bb plugin build && node scripts/add-legacy-css-fallback.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:css": "node scripts/check-fragile-classes.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "motion": "^13.5.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "^0.4.47",
    "@radix-ui/react-dialog": "^1.1.19",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.0",
    "hono": "^4.11.9",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
